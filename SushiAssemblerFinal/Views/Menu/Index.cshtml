@model SushiAssemblerFinal.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "Меню";
}

<div class="page-header">
    <h1>Меню</h1>
    <p>Избери от нашите стандартни азиатски ястия.</p>
</div>

<div class="sushi-panel">
    <form asp-controller="Menu" asp-action="Index" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="search" class="form-label">Търсене</label>
                <input type="text"
                       id="search"
                       name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Например: суши, рамен, сьомга..." />
            </div>

            <div class="col-md-4">
                <label for="categoryId" class="form-label">Категория</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">Всички категории</option>

                    @foreach (var category in Model.Categories)
                    {
                        if (Model.CategoryId == category.Id)
                        {
                            <option value="@category.Id" selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    Филтрирай
                </button>

                <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary w-100">
                    Изчисти
                </a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Products.Any())
{
    <div class="alert alert-warning">
        Няма намерени продукти по зададените критерии.
    </div>
}
else
{
    <div class="mb-3">
        <strong>Намерени продукти:</strong> @Model.Products.Count
    </div>

    <div class="row g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col-md-4">
                <div class="card food-card">
                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" />
                    }
                    else
                    {
                        <div class="food-placeholder">
                            🍱
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold">@product.Name</h5>
                            <span class="price-badge">@product.Price EUR</span>
                        </div>

                        <p class="card-text text-muted">
                            @product.Description
                        </p>

                        @if (product.Category != null)
                        {
                            <div class="mb-3">
                                <span class="category-badge">@product.Category.Name</span>
                            </div>
                        }

                        <div class="mt-auto">
                            <a asp-controller="Cart"
                               asp-action="AddToCart"
                               asp-route-id="@product.Id"
                               class="btn btn-primary w-100">
                                Добави в количката
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}