@model List<SushiAssemblerFinal.Models.CartItem>

@{
    ViewData["Title"] = "Количка";
    decimal total = Model.Sum(x => x.Total);
}

<h1>Количка</h1>

@if (!Model.Any())
{
    <p>Количката е празна.</p>

    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">
        Към менюто
    </a>

    <a asp-controller="SushiBuilder" asp-action="Index" class="btn btn-outline-primary">
        Създай суши
    </a>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Продукт</th>
                <th>Описание</th>
                <th>Цена</th>
                <th>Количество</th>
                <th>Общо</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.ProductName

                        @if (item.IsCustom)
                        {
                            <span class="badge bg-success">Custom</span>
                        }
                    </td>

                    <td>@item.Details</td>
                    <td>@item.Price лв.</td>
                    <td>@item.Quantity</td>
                    <td>@item.Total лв.</td>
                    <td>
                        <a asp-controller="Cart"
                           asp-action="DecreaseQuantity"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-secondary">
                            -
                        </a>

                        <a asp-controller="Cart"
                           asp-action="IncreaseQuantity"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-secondary">
                            +
                        </a>

                        <a asp-controller="Cart"
                           asp-action="RemoveFromCart"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-danger">
                            Премахни
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Крайна сума: @total лв.</h3>

    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">
        Продължи пазаруването
    </a>

    <a asp-controller="SushiBuilder" asp-action="Index" class="btn btn-outline-primary">
        Създай суши
    </a>

    <a asp-controller="Cart" asp-action="ClearCart" class="btn btn-warning">
        Изчисти количката
    </a>

    <a asp-controller="Order" asp-action="Checkout" class="btn btn-success">
        Поръчай
    </a>
}