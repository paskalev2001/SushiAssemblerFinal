@model List<SushiAssemblerFinal.Models.Ingredient>

@{
    ViewData["Title"] = "Админ - Съставки";
}

<h1>Управление на съставките</h1>

<p>
    <a asp-controller="AdminIngredients" asp-action="Create" class="btn btn-success">
        Добави нова съставка
    </a>
</p>

@if (!Model.Any())
{
    <p>Няма добавени съставки.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Име</th>
                <th>Тип</th>
                <th>Цена</th>
                <th>Налична</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ingredient in Model)
            {
                <tr>
                    <td>@ingredient.Name</td>
                    <td>@ingredient.Type</td>
                    <td>@ingredient.Price EUR</td>
                    <td>
                        @if (ingredient.IsAvailable)
                        {
                            <span class="badge bg-success">Да</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Не</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="AdminIngredients"
                           asp-action="Edit"
                           asp-route-id="@ingredient.Id"
                           class="btn btn-sm btn-warning">
                            Редактирай
                        </a>

                        <a asp-controller="AdminIngredients"
                           asp-action="Delete"
                           asp-route-id="@ingredient.Id"
                           class="btn btn-sm btn-danger">
                            Изтрий
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}