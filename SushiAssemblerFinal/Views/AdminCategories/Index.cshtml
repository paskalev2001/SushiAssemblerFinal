@model List<SushiAssemblerFinal.Models.Category>

@{
    ViewData["Title"] = "Админ - Категории";
}

<h1>Управление на категории</h1>

<p>
    <a asp-controller="AdminCategories" asp-action="Create" class="btn btn-success">
        Добави нова категория
    </a>
</p>

@if (!Model.Any())
{
    <p>Няма добавени категории.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Име</th>
                <th>Брой продукти</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Products.Count</td>
                    <td>
                        <a asp-controller="AdminCategories"
                           asp-action="Edit"
                           asp-route-id="@category.Id"
                           class="btn btn-sm btn-warning">
                            Редактирай
                        </a>

                        <a asp-controller="AdminCategories"
                           asp-action="Delete"
                           asp-route-id="@category.Id"
                           class="btn btn-sm btn-danger">
                            Изтрий
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}