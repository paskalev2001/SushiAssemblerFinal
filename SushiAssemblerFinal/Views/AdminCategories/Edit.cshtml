@model SushiAssemblerFinal.Models.Category

@{
    ViewData["Title"] = "Редакция на категория";
}

<h1>Редакция на категория</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Име</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Запази промените
    </button>

    <a asp-controller="AdminCategories" asp-action="Index" class="btn btn-secondary">
        Назад
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}