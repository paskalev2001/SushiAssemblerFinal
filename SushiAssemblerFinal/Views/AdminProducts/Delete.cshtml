@model SushiAssemblerFinal.Models.Product

@{
    ViewData["Title"] = "Изтриване на продукт";
}

<h1>Изтриване на продукт</h1>

<div class="alert alert-danger">
    Сигурен ли си, че искаш да изтриеш този продукт?
</div>

<dl class="row">
    <dt class="col-sm-3">Име</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Категория</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>

    <dt class="col-sm-3">Цена</dt>
    <dd class="col-sm-9">@Model.Price EUR</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Изтрий
    </button>

    <a asp-controller="AdminProducts" asp-action="Index" class="btn btn-secondary">
        Отказ
    </a>
</form>