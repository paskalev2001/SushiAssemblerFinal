@model List<SushiAssemblerFinal.Models.Product>

@{
    ViewData["Title"] = "Админ - Продукти";
}

<h1>Управление на менюто</h1>

<p>
    <a asp-controller="AdminProducts" asp-action="Create" class="btn btn-success">
        Добави нов продукт
    </a>
</p>

@if (!Model.Any())
{
    <p>Няма добавени продукти.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Име</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Наличен</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Category?.Name</td>
                    <td>@product.Price лв.</td>
                    <td>
                        @if (product.IsAvailable)
                        {
                            <span class="badge bg-success">Да</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Не</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="AdminProducts"
                           asp-action="Edit"
                           asp-route-id="@product.Id"
                           class="btn btn-sm btn-warning">
                            Редактирай
                        </a>

                        <a asp-controller="AdminProducts"
                           asp-action="Delete"
                           asp-route-id="@product.Id"
                           class="btn btn-sm btn-danger">
                            Изтрий
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}